# Domain
# Base domain name for routing and Let's Encrypt (e.g. example.com in production)
DOMAIN=localhost
# For local subdomain testing with Traefik:
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In production, set to your frontend domain, e.g. https://dashboard.example.com
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="ExoScope"
STACK_NAME=exoscope

# Backend Security & Admin Credentials
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_ADMIN=admin@example.com
FIRST_ADMIN_PASSWORD=changethis

# Emails (Mailcatcher in local development; configure real SMTP for production)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Sentry Monitoring (optional)
SENTRY_DSN=

# Docker registry image tags (used in CI/CD & production builds)
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Automated ETL Scheduler
ETL_SCHEDULER_ENABLED=true
ETL_SCHEDULER_INTERVAL_SECONDS=86400 # 24 hours
